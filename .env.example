# Copy to .env and fill in before running `docker compose up -d`

# Latest completed stable release. To pin a version, use its exact tag
# (e.g. ghcr.io/xxshade/weebreader:8.3.6) or the digest from its Release.
PUBLICATION_READER_IMAGE=ghcr.io/xxshade/weebreader:latest

APP_WEBAUTHN_RP_ID=reader.yourdomain.com
APP_WEBAUTHN_ORIGIN=https://reader.yourdomain.com
LIBRARY_PATH=/absolute/path/on/host/to/your/library

# Optional -- one of DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO.
# APP_LOG_LEVEL=DEBUG

# ---- MyAnimeList tracking (optional) ----
# Register an app at https://myanimelist.net/apiconfig. The redirect URI
# and client ID are required to start a new link (neither has a default). The URI must
# match what you register there EXACTLY -- MAL refuses anything else,
# and a mismatch shows up as a login page that loops.
#
# The secret is issued alongside the id for most app types; without it the
# token exchange fails with `invalid_client: Client authentication failed`.
# Leave it out only if your app was registered without one.
# APP_MYANIMELIST_CLIENT_ID=your-client-id
# APP_MYANIMELIST_CLIENT_SECRET=your-client-secret
# APP_MYANIMELIST_REDIRECT_URI=https://reader.yourdomain.com/settings/tracking/myanimelist/callback
